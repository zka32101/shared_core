# Dart / Flutter package .gitignore

# Tooling / IDE
.dart_tool/
.packages
.pub-cache/
.pub/
build/

# Generated lockfile — package repos generally leave this out
# so consuming apps resolve versions themselves.
pubspec.lock

# IDE
.idea/
.vscode/
*.iml

# macOS
.DS_Store

# Coverage
coverage/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
# 実際のtfvars(値そのものは機密なし=プロジェクトID等だが、誤って秘密情報が
# 書き込まれた場合の保険としてsample以外はレビュー必須)

