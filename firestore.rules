rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =====================
    // Phase 4.3: ランキング
    // =====================

    // ランキングの集計は Cloud Functions（管理者権限、ルールを迂回）だけが書く。
    // クライアントが直接書けるとスコアを改ざんできるため、書き込みは全面禁止。
    // 公開読取: 表示名（ニックネーム）と点数のみを入れること。本名・学年・メールは入れない（COPPA）。

    // グローバルランキング
    match /global_rankings/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // 教科別ランキング
    match /subject_rankings/{subject}/users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ユーザーランキング統計（読取は本人と管理者のみ。集計は Cloud Functions）
    match /user_ranking_stats/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // =====================
    // Phase 4.5: ミッション
    // =====================

    // ユーザーミッション進捗（本人のみ）。docId は「<uid>_<missionId>」。
    // 新規作成時は resource が null なので、作成は request.resource.data で判定する。
    match /user_mission_progress/{docId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && docId.matches(request.auth.uid + '_.*');
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }

    // ミッション初期化フラグ（本人のみ）
    match /user_missions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // デイリーミッションの進捗（本人のみ）
    match /analytics/daily_missions/users/{userId}/progress/{date} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ミッションマスター（公開読取、管理者のみ書込）
    match /mission_master/{missionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =====================
    // Phase 4.6: スクリーンタイム
    // =====================

    // 利用時間ログ（本人と親のみ）
    match /screen_time_logs/{userId}/daily/{date} {
      allow read: if request.auth != null && (request.auth.uid == userId || isParentOf(userId) || isAdmin());
      allow write: if isAdmin();
    }

    // 親の設定（親本人のみ）
    match /parent_settings/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // =====================
    // Phase 4.4: フレンド機能
    // =====================

    // フレンド申請（本人のみ）
    match /friend_requests/{fromUserId}/pending/{toUserId} {
      allow read: if request.auth.uid == fromUserId || request.auth.uid == toUserId || isAdmin();
      allow write: if request.auth.uid == fromUserId || isAdmin();
      allow delete: if request.auth.uid == fromUserId || request.auth.uid == toUserId || isAdmin();
    }

    // フレンド関係（本人のみ）
    match /friends/{userId}/connections/{friendId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // =====================
    // ユーティリティ関数
    // =====================

    // 管理者判定
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isAdmin == true;
    }

    // 親-子関係判定
    function isParentOf(childUserId) {
      // exists() は get(...).data のメソッドではなくパスに対する関数
      return request.auth != null &&
             exists(/databases/$(database)/documents/parent_relationships/$(request.auth.uid)/children/$(childUserId));
    }

    // デフォルト：すべてを拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
